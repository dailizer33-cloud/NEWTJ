+    -- =========================================================
+    -- EVENT BOSS DIRECTOR (Shout-driven, from spy logs 2026-11-27)
+    --   "A GIANT MANTIS appeared in the Flower Field"  -> boss announced
+    --   "THE ORCHID MANTIS IS DOWN! Top hunter: ..."   -> boss finished
+    -- A model whose name matches the announced boss is treated as boss-hud:
+    --   priority target (preempts normal monsters), warp allowed, stands behind it,
+    --   never skipped for "HP not changing".
+    -- =========================================================
+    local eventBoss = nil -- { key = "giantmantis", name = "GIANT MANTIS", at = os.clock() }
+    local EVENT_BOSS_TTL = 900
+    local function isEventBossName(modelName)
+        local eb = eventBoss
+        if not eb then return false end
+        if os.clock() - eb.at > EVENT_BOSS_TTL then eventBoss = nil return false end
+        local key = normalizeKey(modelName)
+        if key == "" then return false end
+        if key == eb.key then return true end
+        if #eb.key >= 6 and string.find(key, eb.key, 1, true) then return true end
+        if #key >= 6 and string.find(eb.key, key, 1, true) then return true end
+        return false
+    end
+    local function stripBossArticle(name)
+        local n = string.gsub(name, "^%s+", "")
+        n = string.gsub(n, "^THE%s+", "")
+        n = string.gsub(n, "^AN?%s+", "")
+        n = string.gsub(n, "%s+$", "")
+        return n
+    end
+    local function handleShout(text)
+        local upper = string.upper(tostring(text or ""))
+        local appeared = string.match(upper, "^(.-)%s+APPEARED")
+        local down = string.match(upper, "^(.-)%s+IS DOWN")
+        if appeared and #appeared > 0 then
+            local name = stripBossArticle(appeared)
+            if #name >= 3 then
+                eventBoss = { key = normalizeKey(name), name = name, at = os.clock() }
+                monsterScanDirty = true
+                monsterNextSelectAt = 0
+                print("[TAYJAY EVENT] boss announced: " .. name)
+            end
+        elseif down and #down > 0 then
+            local key = normalizeKey(stripBossArticle(down))
+            if eventBoss and (eventBoss.key == key or string.find(eventBoss.key, key, 1, true)) then
+                eventBoss = nil
+            end
+            monsterScanDirty = true
+            print("[TAYJAY EVENT] boss down: " .. stripBossArticle(down))
+        end
+    end
+    task.spawn(function()
+        local folder = ReplicatedStorage:FindFirstChild("AntRemotes")
+            or ReplicatedStorage:WaitForChild("AntRemotes", 15)
+        local shout = folder and (folder:FindFirstChild("Shout") or folder:WaitForChild("Shout", 10))
+        if not shout or not shout:IsA("RemoteEvent") then return end
+        trackConnection(shout.OnClientEvent:Connect(function(text)
+            pcall(handleShout, text)
+        end))
+    end)
